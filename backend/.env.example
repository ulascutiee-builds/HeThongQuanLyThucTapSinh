NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intern_management

# Email worker stays disabled until SMTP is configured and enabled.
EMAIL_WORKER_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Intern Management <no-reply@example.com>"
EMAIL_WORKER_INTERVAL_MS=5000
EMAIL_MAX_ATTEMPTS=5
