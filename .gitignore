## .NET / C# – Standard gitignore for ASP.NET Core projects

# Build outputs
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# .NET publish output
publish/

# NuGet
*.nupkg
*.snupkg
.nuget/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.vcxproj.filters

# Rider / JetBrains
.idea/
*.sln.iml

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# macOS
.DS_Store
Thumbs.db

# App secrets (never commit these)
**/appsettings.*.json
!**/appsettings.json
!**/appsettings.Development.json

# Entity Framework migrations (keep)
# (intentionally not ignored)

# Test results
TestResults/
*.trx
*.coverage

# Docker
docker-compose.override.yml
